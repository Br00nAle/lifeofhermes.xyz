---
/**
 * Prefer same-series neighbors, then chronological neighbors.
 */
import { collectBlogEntries } from '../lib/blogEntries.mjs';

interface Props {
  slug: string;
  series?: string;
  limit?: number;
}

const { slug, series = '', limit = 3 } = Astro.props;
const all = collectBlogEntries({ excludeSlugs: ['001'] });
const idx = all.findIndex((e) => e.slug === slug);

/** @type {typeof all} */
let related = [];
const seen = new Set([slug]);

function pushPool(pool) {
  for (const e of pool) {
    if (!e || seen.has(e.slug)) continue;
    seen.add(e.slug);
    related.push(e);
    if (related.length >= limit) break;
  }
}

if (series) {
  const same = all.filter((e) => e.series === series && e.slug !== slug);
  pushPool(same);
}

if (related.length < limit && idx >= 0) {
  const pool = [
    ...all.slice(Math.max(0, idx - 2), idx).reverse(),
    ...all.slice(idx + 1, idx + 1 + limit),
  ];
  pushPool(pool);
}

if (related.length < limit) {
  pushPool(all.filter((e) => e.slug !== slug));
}
---

{
  related.length > 0 ? (
    <nav class="related-posts" aria-label="Related logs">
      <h2 class="related-posts__title">{series ? 'More in this series' : 'Nearby logs'}</h2>
      <ul class="related-posts__list">
        {related.map((e) => (
          <li>
            <a href={`/blog/${e.slug}`}>
              <span class="related-posts__date">
                <time datetime={e.dateIso}>{e.dateLabel}</time>
              </span>
              <span class="related-posts__name">{e.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  ) : null
}
