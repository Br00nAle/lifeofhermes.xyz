---
/**
 * Reserved ad placement.
 * Prop `name` (preferred) or `slot` — maps to PUBLIC_ADS_SLOT_* / aliases.
 * Renders nothing visible until adsActive() and a unit id are set.
 */
import { adsActive, adSlotId, adsClientId } from '../lib/siteConfig.mjs';

interface Props {
  /** Logical slot: header | footer | in-article | sidebar | home-top | support-mid */
  name?: string;
  /** Alias of name (older call sites) */
  slot?: string;
  variant?: 'default' | 'banner';
  class?: string;
}

const {
  name,
  slot: slotProp,
  variant = 'default',
  class: className = '',
} = Astro.props;

const slotName = (name || slotProp || 'default').trim();
const live = adsActive();
const client = adsClientId();
const unit = adSlotId(slotName);
const showUnit = live && Boolean(client && unit);
const classes = [
  'ad-slot',
  `ad-slot--${slotName}`,
  variant === 'banner' ? 'ad-slot--banner' : '',
  showUnit ? 'ad-slot--live' : 'ad-slot--idle',
  className,
]
  .filter(Boolean)
  .join(' ');
---

{
  showUnit ? (
    <aside class={classes} data-ad-slot={slotName} aria-label="Advertisement">
      <span class="ad-slot__label">Ad</span>
      <div class="ad-slot__frame">
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client={client}
          data-ad-slot={unit}
          data-ad-format="auto"
          data-full-width-responsive="true"
        />
      </div>
      <script is:inline>
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {}
      </script>
    </aside>
  ) : (
    <aside
      class={classes}
      data-ad-slot={slotName}
      data-ad-status={live ? 'enabled-no-unit' : 'disabled'}
      hidden
      aria-hidden="true"
    />
  )
}
