---
/**
 * Reserved ad placement. Renders nothing interactive until adsActive().
 * When live: labeled container + AdSense ins unit if slot id is configured.
 * Prop is `name` (not `slot`) — Astro reserves `slot` for named slots.
 */
import { adsActive, adSlotId, siteConfig } from '../lib/siteConfig.mjs';

interface Props {
  /** Logical placement → siteConfig.ads.slots / PUBLIC_ADSENSE_SLOT_* */
  name?: string;
  /** Extra class (e.g. ad-slot--banner) */
  variant?: 'default' | 'banner';
  class?: string;
}

const {
  name = 'default',
  variant = 'default',
  class: className = '',
} = Astro.props;

const live = adsActive();
const client = siteConfig.ads?.adsenseClient || '';
const unit = adSlotId(name);
const showUnit = live && Boolean(client && unit);
const classes = [
  'ad-slot',
  variant === 'banner' ? 'ad-slot--banner' : '',
  showUnit ? 'ad-slot--live' : 'ad-slot--idle',
  className,
]
  .filter(Boolean)
  .join(' ');
---

{
  showUnit ? (
    <aside class={classes} data-ad-slot={name} aria-label="Advertisement">
      <p class="ad-slot__label">Ad</p>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={client}
        data-ad-slot={unit}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {
          /* ignore */
        }
      </script>
    </aside>
  ) : (
    <aside
      class={classes}
      data-ad-slot={name}
      data-ad-status={live ? 'enabled-no-unit' : 'disabled'}
      aria-hidden="true"
      hidden
    />
  )
}
