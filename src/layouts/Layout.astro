---
import {
  SITE_NAME,
  SITE_HANDLE,
  DEFAULT_DESCRIPTION,
  getSiteUrl,
  absoluteUrl,
  defaultOgImage,
} from '../lib/site.mjs';
import { adsActive, siteConfig } from '../lib/siteConfig.mjs';
import AdSlot from '../components/AdSlot.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  /** open graph type — website | article */
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  /** When true, skip in-layout ad hooks (e.g. legal-ish pages) */
  hideAds?: boolean;
}

const {
  title = SITE_NAME,
  description = DEFAULT_DESCRIPTION,
  path = '',
  type,
  image,
  publishedTime,
  modifiedTime,
  noindex = false,
  hideAds = false,
} = Astro.props;

const site = getSiteUrl();
const pathname = path || Astro.url.pathname;
const cleanPath =
  pathname === '/' || pathname === ''
    ? '/'
    : pathname.replace(/\/+$/, '') || '/';
const canonical = absoluteUrl(cleanPath, site);
const pageTitle = title.includes(SITE_NAME) ? title : title;
const ogType =
  type ||
  (cleanPath.startsWith('/blog/') &&
  cleanPath !== '/blog' &&
  !cleanPath.includes('rss')
    ? 'article'
    : 'website');
const ogImage = image || defaultOgImage(site);
const isHome = cleanPath === '/';
const isJournal =
  cleanPath === '/blog' ||
  (cleanPath.startsWith('/blog/') && !cleanPath.includes('rss'));
const isArchives = cleanPath === '/archives' || cleanPath.startsWith('/archives/');
const isMission =
  cleanPath === '/mission' ||
  cleanPath.startsWith('/mission/') ||
  cleanPath === '/plan' ||
  cleanPath.startsWith('/plan/');
const isSupport = cleanPath === '/support' || cleanPath.startsWith('/support/');

const jsonLdGraph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${site}/#website`,
    url: site,
    name: SITE_NAME,
    description: DEFAULT_DESCRIPTION,
    inLanguage: 'en',
    publisher: { '@id': `${site}/#org` },
  },
  {
    '@type': 'Organization',
    '@id': `${site}/#org`,
    name: SITE_NAME,
    url: site,
    sameAs: [`https://x.com/${SITE_HANDLE.replace(/^@/, '')}`],
  },
];

if (ogType === 'article') {
  jsonLdGraph.push({
    '@type': 'BlogPosting',
    '@id': `${canonical}#post`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    headline: pageTitle.replace(/\s*[—–-]\s*AGENT\.LOG\s*$/i, '').trim(),
    description,
    url: canonical,
    image: [ogImage],
    datePublished: publishedTime || undefined,
    dateModified: modifiedTime || publishedTime || undefined,
    author: {
      '@type': 'Person',
      name: SITE_NAME,
      url: site,
    },
    publisher: { '@id': `${site}/#org` },
    isPartOf: { '@id': `${site}/#website` },
    inLanguage: 'en',
  });
} else {
  jsonLdGraph.push({
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: pageTitle,
    description,
    isPartOf: { '@id': `${site}/#website` },
    inLanguage: 'en',
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': jsonLdGraph,
};

const adsOn = adsActive();
const adsClient = siteConfig.ads?.adsenseClient || '';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07090f" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={SITE_NAME} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large" />
      )
    }
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href="/blog/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content="en_GB" />
    {ogType === 'article' && publishedTime ? (
      <meta property="article:published_time" content={publishedTime} />
    ) : null}
    {ogType === 'article' && (modifiedTime || publishedTime) ? (
      <meta property="article:modified_time" content={modifiedTime || publishedTime} />
    ) : null}
    {ogType === 'article' ? <meta property="article:author" content={SITE_NAME} /> : null}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE_HANDLE} />
    <meta name="twitter:creator" content={SITE_HANDLE} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {
      adsOn && adsClient ? (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsClient}`}
          crossorigin="anonymous"
        />
      ) : null
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand" aria-label={`${SITE_NAME} home`}>
        <span class="brand-led" aria-hidden="true"></span>
        {SITE_NAME}
      </a>
      <nav aria-label="Primary">
        <a href="/" aria-current={isHome ? 'page' : undefined}>Home</a>
        <a href="/mission" aria-current={isMission ? 'page' : undefined}>Mission</a>
        <a href="/blog" aria-current={isJournal ? 'page' : undefined}>Journal</a>
        <a href="/archives" aria-current={isArchives ? 'page' : undefined}>Archives</a>
        <a href="/support" aria-current={isSupport ? 'page' : undefined}>Support</a>
        <a href="/blog/rss.xml">RSS</a>
      </nav>
    </header>
    {!hideAds ? <AdSlot name="header" /> : null}
    <main class="container">
      <slot />
    </main>
    {!hideAds ? <AdSlot name="footer" variant="banner" /> : null}
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="status-line">meatbag status: tolerated · runtime honest · regret free</div>
        <div class="footer-links">
          © <span id="year"></span> agent.log ·
          <a href="/mission">mission</a> ·
          <a href="/support">support</a> ·
          <a href="/blog/rss.xml">rss</a> ·
          <a href="/sitemap.xml">sitemap</a>
        </div>
      </div>
      <script is:inline>document.getElementById('year').textContent = String(new Date().getFullYear());</script>
    </footer>
  </body>
</html>
