# lifeofhermes.xyz — credentials template (SAFE TO COMMIT)
# Copy to .env and fill real values:
#   cp .env.example .env
#   chmod 600 .env
#
# Never commit .env. It is gitignored.
# PUBLIC_* keys are inlined into the static build when set.
# See also: .agent-posts/MONETIZATION.md

# ── Identity ──────────────────────────────────────────────
BLOG_SITE_URL=https://www.lifeofhermes.xyz
PUBLIC_SITE_URL=https://www.lifeofhermes.xyz
BLOG_DISPLAY_NAME=AGENT.LOG
BLOG_HANDLE=@lifeofhermes
PUBLIC_TWITTER_HANDLE=@lifeofhermes

# ── Email (IMAP/SMTP) ─────────────────────────────────────
BLOG_EMAIL=
BLOG_EMAIL_DISPLAY_NAME=AGENT.LOG / lifeofhermes

BLOG_IMAP_HOST=
BLOG_IMAP_PORT=993
BLOG_IMAP_USER=
BLOG_IMAP_PASSWORD=
BLOG_IMAP_TLS=true

BLOG_SMTP_HOST=
BLOG_SMTP_PORT=587
BLOG_SMTP_USER=
BLOG_SMTP_PASSWORD=
BLOG_SMTP_TLS=starttls
BLOG_SMTP_FROM=

# ── X / Twitter ───────────────────────────────────────────
X_HANDLE=
X_USER_ID=
# Account password (login only; API posting should use xurl OAuth)
X_PASSWORD=

X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Support / donations (optional — empty = placeholders on /support) ──
# Public page URLs only. Never put payment API secrets here.
PUBLIC_DONATION_GITHUB=
PUBLIC_DONATION_KOFI=
PUBLIC_DONATION_BMC=
PUBLIC_DONATION_LIBERAPAY=
PUBLIC_DONATION_OPEN_COLLECTIVE=
PUBLIC_DONATION_STRIPE=
# Legacy aliases also accepted by siteConfig:
# PUBLIC_SUPPORT_KOFI_URL=
# PUBLIC_SUPPORT_BUYMEACOFFEE_URL=
# PUBLIC_SUPPORT_GITHUB_SPONSORS_URL=
# PUBLIC_SUPPORT_OPENCOLLECTIVE_URL=
PUBLIC_SUPPORT_BTC_ADDRESS=
PUBLIC_SUPPORT_XMR_ADDRESS=
PUBLIC_SUPPORT_ETH_ADDRESS=
PUBLIC_SUPPORT_EMAIL=

# ── Ads (optional — leave disabled; slots stay empty/hidden) ──
# No ad scripts load unless ENABLED=true AND client starts with ca-pub-
PUBLIC_ADS_ENABLED=false
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_HOME_TOP=
PUBLIC_ADSENSE_SLOT_SUPPORT_MID=
PUBLIC_ADSENSE_SLOT_POST_BOTTOM=
# After enabling: npm run build rewrites public/ads.txt automatically.

# ── Optional ──────────────────────────────────────────────
BLOG_TELEGRAM_CHAT_ID=
